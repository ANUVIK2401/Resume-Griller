{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aws.schema.json",
  "title": "AWS glossary, frameworks, and resume mapping",
  "type": "object",
  "required": ["mental_model", "status_options", "families", "tiers", "services", "acronyms", "pillars", "seven_rs", "dr_tiers", "shared_responsibility", "resume_map"],
  "properties": {
    "mental_model": { "$ref": "common.schema.json#/$defs/text" },
    "verify_note": { "$ref": "common.schema.json#/$defs/text" },
    "status_options": { "type": "array", "items": { "type": "object", "required": ["id", "label"] } },
    "families": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "type": "string" } } } },
    "tiers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "required": ["level", "name", "note"], "properties": { "level": { "enum": [1, 2, 3] }, "name": { "$ref": "common.schema.json#/$defs/text" }, "note": { "$ref": "common.schema.json#/$defs/text" } } } },
    "services": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "family", "tier", "name", "full_form", "what", "pick_when", "trap"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "family": { "type": "string", "description": "families[].id" },
          "tier": { "enum": [1, 2, 3], "description": "tiers[].level: 1 must know, 2 follow-up, 3 recognize" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "full_form": { "$ref": "common.schema.json#/$defs/text", "description": "Official product name, spelling out any acronym" },
          "what": { "$ref": "common.schema.json#/$defs/text", "description": "What it is, in one line" },
          "pick_when": { "$ref": "common.schema.json#/$defs/text" },
          "trap": { "$ref": "common.schema.json#/$defs/text", "description": "When not to pick it, or the misconception interviewers probe" }
        }
      }
    },
    "acronyms": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["acronym", "full_form", "service"], "additionalProperties": false, "properties": { "acronym": { "type": "string", "minLength": 1 }, "full_form": { "$ref": "common.schema.json#/$defs/text" }, "service": { "type": ["string", "null"], "description": "services[].id, or null for a concept" } } } },
    "pillars": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "object", "required": ["id", "name", "question", "practices", "tie"] } },
    "seven_rs": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "object", "required": ["id", "name", "what", "example"] } },
    "dr_tiers": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "required": ["id", "name", "rpo", "rto", "cost", "how"] } },
    "dr_terms": { "type": "array", "items": { "type": "object", "required": ["term", "meaning"] } },
    "shared_responsibility": { "type": "object", "required": ["aws", "customer", "note"] },
    "other_frameworks": { "type": "array", "items": { "type": "object", "required": ["name", "what"] } },
    "resume_map": { "type": "array", "items": { "type": "object", "required": ["you_did", "aws", "story"], "properties": { "you_did": { "$ref": "common.schema.json#/$defs/text" }, "aws": { "$ref": "common.schema.json#/$defs/text" }, "story": { "type": ["string", "null"], "description": "behavioral.stories[].id" } } } }
  }
}
