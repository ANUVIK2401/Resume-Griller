{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop.schema.json",
  "title": "Confirmed Amazon SA loop: schedule, evaluation streams, rounds, 7-day plan, and day-of checklist.",
  "type": "object",
  "required": ["req", "event", "role", "schedule", "streams", "focus_areas", "answer_rubric", "rounds", "round_expect", "unknowns", "plan", "day_of", "logistics"],
  "properties": {
    "req": {
      "type": "object",
      "required": ["id", "title", "company"],
      "properties": {
        "id": { "type": "string" },
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "company": { "type": "string" },
        "source": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "event": {
      "type": "object",
      "required": ["date", "target_date", "confirmed", "location", "arrive", "window", "note"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$", "description": "First interview start, Pacific Time." },
        "target_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "confirmed": { "type": "boolean" },
        "confirmed_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "location": { "$ref": "common.schema.json#/$defs/text" },
        "arrive": { "$ref": "common.schema.json#/$defs/text" },
        "window": { "$ref": "common.schema.json#/$defs/text" },
        "note": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "role": {
      "type": "object",
      "required": ["summary", "focus"],
      "properties": {
        "summary": { "$ref": "common.schema.json#/$defs/text" },
        "focus": { "$ref": "common.schema.json#/$defs/textList" }
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time", "label", "kind"],
        "properties": {
          "time": { "$ref": "common.schema.json#/$defs/text" },
          "label": { "$ref": "common.schema.json#/$defs/text" },
          "kind": { "enum": ["round", "break"] }
        }
      }
    },
    "streams": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "parts", "page"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "title": { "$ref": "common.schema.json#/$defs/text" },
          "summary": { "$ref": "common.schema.json#/$defs/text" },
          "page": { "type": "string", "description": "site.pages[].id" },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "text"],
              "properties": {
                "label": { "$ref": "common.schema.json#/$defs/text" },
                "text": { "$ref": "common.schema.json#/$defs/text" }
              }
            }
          }
        }
      }
    },
    "focus_areas": {
      "type": "object",
      "required": ["depth", "breadth", "backup", "note"],
      "properties": {
        "depth": { "type": "string", "description": "domains.domains[].id" },
        "breadth": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "backup": { "type": "array", "items": { "type": "string" } },
        "note": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "answer_rubric": { "$ref": "common.schema.json#/$defs/textList" },
    "rounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "order", "time", "title", "checklist"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "order": { "type": "integer", "minimum": 1 },
          "time": { "$ref": "common.schema.json#/$defs/text" },
          "title": { "$ref": "common.schema.json#/$defs/text" },
          "checklist": { "$ref": "#/$defs/checks" }
        }
      }
    },
    "round_expect": { "$ref": "common.schema.json#/$defs/textList" },
    "unknowns": { "$ref": "common.schema.json#/$defs/textList" },
    "plan": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "date", "focus", "gate", "tasks"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "focus": { "$ref": "common.schema.json#/$defs/text" },
          "gate": { "$ref": "common.schema.json#/$defs/text" },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text", "page", "minutes", "minimum"],
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "text": { "$ref": "common.schema.json#/$defs/text" },
                "page": { "type": "string", "description": "site.pages[].id" },
                "anchor": { "type": "string", "description": "Section id on that page." },
                "minutes": { "type": "integer", "minimum": 1 },
                "minimum": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "day_of": {
      "type": "object",
      "required": ["arrive", "bring", "notes"],
      "properties": {
        "arrive": { "$ref": "common.schema.json#/$defs/text" },
        "bring": { "$ref": "#/$defs/checks" },
        "notes": { "$ref": "common.schema.json#/$defs/textList" }
      }
    },
    "logistics": { "$ref": "common.schema.json#/$defs/textList" }
  },
  "$defs": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "text": { "$ref": "common.schema.json#/$defs/text" }
        }
      }
    }
  }
}
