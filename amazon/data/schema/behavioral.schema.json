{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavioral.schema.json",
  "title": "Leadership Principles: pitch, STAR bank with 2 to 4 minute versions, the 16-LP map led by the 8 named for this role, recruiter sample questions, LP question bank, self-assessment rubric, and gap worksheets.",
  "type": "object",
  "required": [
    "rules",
    "status_options",
    "pitch",
    "lps",
    "gaps",
    "stories",
    "self_rubric",
    "samples",
    "question_bank"
  ],
  "properties": {
    "rules": {
      "$ref": "common.schema.json#/$defs/textList"
    },
    "status_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "pitch": {
      "type": "object",
      "required": [
        "target_sec",
        "beats",
        "closing_line"
      ],
      "properties": {
        "target_sec": {
          "type": "integer"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "text": {
                "$ref": "common.schema.json#/$defs/text"
              }
            }
          }
        },
        "closing_line": {
          "$ref": "common.schema.json#/$defs/text"
        }
      }
    },
    "lps": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "meaning",
          "primary",
          "backup"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "meaning": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "primary": {
            "type": [
              "string",
              "null"
            ],
            "description": "stories[].id"
          },
          "backup": {
            "type": [
              "string",
              "null"
            ],
            "description": "stories[].id"
          },
          "gap": {
            "type": "string",
            "description": "gaps[].id still to write for this LP"
          },
          "named": {
            "type": "boolean",
            "description": "One of the 8 LPs the recruiter named for this role."
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lps",
          "asked_as",
          "seeds"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "lps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asked_as": {
            "$ref": "common.schema.json#/$defs/textList"
          },
          "seeds": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "template": {
            "type": "object",
            "required": [
              "s",
              "t",
              "a",
              "r"
            ],
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "required": {
            "type": "boolean",
            "description": "Must be written before the loop."
          },
          "worksheet": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key",
                "prompt"
              ],
              "properties": {
                "key": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "prompt": {
                  "$ref": "common.schema.json#/$defs/text"
                }
              }
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "experience_id",
          "lps",
          "number_ids",
          "headline",
          "s",
          "t",
          "a",
          "r",
          "lesson",
          "twist",
          "aws",
          "probes",
          "evidence_note",
          "long"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "code": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "experience_id": {
            "type": "string",
            "description": "profile.experience[].id or profile.projects[].id"
          },
          "lead": {
            "type": "boolean"
          },
          "ongoing": {
            "type": "boolean",
            "description": "Say building, not built."
          },
          "note": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "lps": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            },
            "maxItems": 6
          },
          "number_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "profile.numbers[].id"
            }
          },
          "headline": {
            "$ref": "common.schema.json#/$defs/text",
            "description": "Answer-first opener: the result in one sentence."
          },
          "lesson": {
            "$ref": "common.schema.json#/$defs/text",
            "description": "One-line takeaway to close on."
          },
          "s": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "t": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "a": {
            "$ref": "common.schema.json#/$defs/textList"
          },
          "r": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "twist": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "aws": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "probes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "q",
                "a"
              ],
              "properties": {
                "q": {
                  "$ref": "common.schema.json#/$defs/text"
                },
                "a": {
                  "$ref": "common.schema.json#/$defs/text"
                }
              }
            }
          },
          "evidence_note": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "long": {
            "type": "object",
            "description": "Extra beats that turn the core STAR into a 2 to 4 minute answer.",
            "required": [
              "stakes",
              "obstacle",
              "tradeoff",
              "buy_in",
              "result",
              "different",
              "at_aws"
            ],
            "additionalProperties": false,
            "properties": {
              "stakes": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "obstacle": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "tradeoff": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "buy_in": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "result": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "different": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "at_aws": {
                "$ref": "common.schema.json#/$defs/text"
              }
            }
          }
        }
      }
    },
    "self_rubric": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "q",
          "opener"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "q": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "story": {
            "type": "string",
            "description": "stories[].id"
          },
          "alt": {
            "type": "string",
            "description": "stories[].id"
          },
          "gap": {
            "type": "string",
            "description": "gaps[].id"
          },
          "opener": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "lp": {
            "type": "string",
            "description": "lps[].id"
          }
        }
      }
    },
    "question_bank": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "q",
          "lp"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "q": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "story": {
            "type": "string",
            "description": "stories[].id"
          },
          "alt": {
            "type": "string",
            "description": "stories[].id"
          },
          "gap": {
            "type": "string",
            "description": "gaps[].id"
          },
          "opener": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "lp": {
            "type": "string",
            "description": "lps[].id"
          }
        }
      }
    }
  }
}
