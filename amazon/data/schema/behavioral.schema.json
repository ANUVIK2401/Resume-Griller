{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavioral.schema.json",
  "title": "Leadership Principles: pitch, STAR bank tagged with LPs, the 16-LP map, and gap templates. Numbers quiz reads profile.json.",
  "type": "object",
  "required": ["rules", "status_options", "pitch", "lps", "gaps", "stories"],
  "properties": {
    "rules": { "$ref": "common.schema.json#/$defs/textList" },
    "status_options": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" } } } },
    "pitch": {
      "type": "object", "required": ["target_sec", "beats", "closing_line"],
      "properties": {
        "target_sec": { "type": "integer" },
        "beats": { "type": "array", "items": { "type": "object", "required": ["label", "text"], "properties": { "label": { "type": "string" }, "text": { "$ref": "common.schema.json#/$defs/text" } } } },
        "closing_line": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "lps": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "required": ["id", "name", "meaning", "primary", "backup"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "meaning": { "$ref": "common.schema.json#/$defs/text" },
          "primary": { "type": ["string", "null"], "description": "stories[].id" },
          "backup": { "type": ["string", "null"], "description": "stories[].id" },
          "gap": { "type": "string", "description": "gaps[].id still to write for this LP" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "lps", "asked_as", "seeds", "template"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "lps": { "type": "array", "items": { "type": "string" } },
          "asked_as": { "$ref": "common.schema.json#/$defs/textList" },
          "seeds": { "$ref": "common.schema.json#/$defs/text" },
          "template": { "type": "object", "required": ["s", "t", "a", "r"], "additionalProperties": { "$ref": "common.schema.json#/$defs/text" } }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "title", "experience_id", "lps", "number_ids", "headline", "s", "t", "a", "r", "lesson", "twist", "aws", "probes"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "code": { "type": "string", "pattern": "^S[0-9]+$" },
          "title": { "$ref": "common.schema.json#/$defs/text" },
          "experience_id": { "type": "string", "description": "profile.experience[].id or profile.projects[].id" },
          "lead": { "type": "boolean" },
          "ongoing": { "type": "boolean", "description": "Say building, not built." },
          "note": { "$ref": "common.schema.json#/$defs/text" },
          "lps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "number_ids": { "type": "array", "items": { "type": "string", "description": "profile.numbers[].id" } },
          "headline": { "$ref": "common.schema.json#/$defs/text", "description": "Answer-first opener: the result in one sentence." },
          "lesson": { "$ref": "common.schema.json#/$defs/text", "description": "One-line takeaway to close on." },
          "s": { "$ref": "common.schema.json#/$defs/text" },
          "t": { "$ref": "common.schema.json#/$defs/text" },
          "a": { "$ref": "common.schema.json#/$defs/textList" },
          "r": { "$ref": "common.schema.json#/$defs/text" },
          "twist": { "$ref": "common.schema.json#/$defs/text" },
          "aws": { "$ref": "common.schema.json#/$defs/text" },
          "probes": { "type": "array", "items": { "type": "object", "required": ["q", "a"], "properties": { "q": { "$ref": "common.schema.json#/$defs/text" }, "a": { "$ref": "common.schema.json#/$defs/text" } } } }
        }
      }
    }
  }
}
