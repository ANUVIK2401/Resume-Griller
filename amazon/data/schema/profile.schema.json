{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Ground truth about the candidate. Every other file defers to this one.",
  "type": "object",
  "required": ["name", "identity", "education", "experience", "numbers", "number_groups"],
  "properties": {
    "name": { "type": "string" },
    "location": { "type": "string" },
    "identity": { "$ref": "common.schema.json#/$defs/text" },
    "availability": { "$ref": "common.schema.json#/$defs/text" },
    "links": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/url" } },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "school", "degree", "dates_display"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "school": { "type": "string" }, "degree": { "type": "string" },
          "gpa": { "type": "string" }, "dates_display": { "$ref": "common.schema.json#/$defs/text" }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "org", "role", "kind", "dates_display", "summary"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "org": { "type": "string" },
          "role": { "type": "string" },
          "kind": { "enum": ["current", "full time", "internship", "volunteer research"] },
          "dates_display": { "$ref": "common.schema.json#/$defs/text", "description": "What prep text says. Oracle is always 'nearly 3 years'." },
          "legal_dates": {
            "type": "object", "description": "Exact dates for forms only. Never rendered in prep text.",
            "required": ["start", "end"],
            "properties": { "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }, "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" } }
          },
          "summary": { "$ref": "common.schema.json#/$defs/text" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "summary"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "type": "string" }, "summary": { "$ref": "common.schema.json#/$defs/text" } } }
    },
    "numbers": {
      "type": "array",
      "description": "Rapid-fire quiz source. Must match the resume exactly.",
      "items": {
        "type": "object",
        "required": ["id", "group", "fact", "q", "a"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "group": { "type": "string", "description": "number_groups[].id" },
          "fact": { "$ref": "common.schema.json#/$defs/text", "description": "Full statement shown after answering." },
          "q": { "$ref": "common.schema.json#/$defs/text" },
          "a": { "type": "string", "pattern": "^[0-9.]+$", "description": "Canonical numeric answer. Commas, %, units are stripped from typed input before comparing." },
          "unit": { "type": "string" },
          "accept": { "type": "array", "items": { "type": "string" }, "description": "Extra accepted spellings, compared case-insensitively." }
        }
      }
    },
    "number_groups": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "label": { "type": "string" } } }
    }
  }
}
